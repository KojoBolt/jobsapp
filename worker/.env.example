# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
# Copy it to worker/.env (which is gitignored) and fill that in instead.
#
# In production none of this file is used: Railway holds the values, set in
# the service's Variables tab. railway.toml deliberately does not list them —
# config in the repo, secrets in the dashboard.

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# SERVICE ROLE key — Settings → API → service_role.
# Full database access, bypasses RLS. Never put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. On Railway, leave this unset — RAILWAY_REPLICA_ID is injected and
# used automatically. Falls back to worker-<hostname>-<pid> locally.
WORKER_ID=

# How often to look for work, in ms.
POLL_INTERVAL_MS=15000

# Applications claimed per cycle.
BATCH_SIZE=5

# Give up on an application after this many tries.
MAX_ATTEMPTS=3

# Claims older than this are assumed dead and handed back.
STALE_CLAIM_MINUTES=15

# SAFETY: anything other than the exact string "false" means dry run.
# While true the worker classifies and reports but never submits.
DRY_RUN=true

# Encrypts ATS account passwords (Workday and anything else that demands a
# login). Base64 of 32 random bytes — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Only needed once a login-gated adapter runs; Greenhouse and Lever never touch
# it, so the worker starts fine without one.
#
# LOSING THIS MAKES EVERY STORED PASSWORD UNRECOVERABLE. Keep a copy somewhere
# safe, and never commit it. If it ever leaks, rotating it means every stored
# credential has to be reset on the tenant that owns it.
ATS_CRED_KEY=
