{
  "name": "jobsapp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Applies to jobs on behalf of users. Runs on Railway, not in Supabase — Playwright needs a real browser and a long-lived process.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "backfill": "tsx src/backfill.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "playwright": "1.47.0",
    "tsx": "^4.19.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0"
  }
}
