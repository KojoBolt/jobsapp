{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // The worker imports the ATS routing table straight from the edge
    // functions' shared folder rather than keeping a second copy that can
    // drift. Bundler resolution lets the .ts extension through.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "../supabase/functions/_shared/ats.ts"]
}
